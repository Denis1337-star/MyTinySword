--- !u!114 &4973408654219321980
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5198689545038958150}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 825378daff1ed094f8b3e0c0705d93b3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _runOnlyOnTutorialLevel: 1
  _uiView: {fileID: 6896818505229677400}
  _cameraFocus: {fileID: 0}
  _houseHighlightTarget: {fileID: 0}
  _constructionSlotHighlightTarget: {fileID: 0}
  _playerWarriorHighlightTarget: {fileID: 0}
  _enemyWarriorHighlightTarget: {fileID: 0}
  _housePanel: {fileID: 3802972525476260357}
  _constructionPanel: {fileID: 6219416277348692924}
  _productionBuildingPanel: {fileID: 799283376644995527}
  _gameResultController: {fileID: 0}
  _steps:
  - _stepType: 0
    _message: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C!
      \u0421\u0435\u0439\u0447\u0430\u0441 \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u043E\u043A\u0430\u0436\u0443
      \u043E\u0441\u043D\u043E\u0432\u044B \u0438\u0433\u0440\u044B."
    _messageEn: Welcome! I'll quickly show you the basics of the game.
    _allowManualNext: 1
    _requiredBuildingConfig: {fileID: 0}
    _minimumWood: 0
    _minimumGold: 0
    _minimumMeat: 0
  - _stepType: 1
    _message: "\u041D\u0430\u0436\u043C\u0438 \u043D\u0430 \u0434\u043E\u043C, \u0447\u0442\u043E\u0431\u044B
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0440\u0430\u0431\u043E\u0447\u0438\u043C\u0438."
    _messageEn: Click on the house to open worker management.
    _allowManualNext: 0
    _requiredBuildingConfig: {fileID: 0}
    _minimumWood: 0
    _minimumGold: 0
    _minimumMeat: 0
  - _stepType: 2
    _message: "\u041D\u0430\u0436\u043C\u0438 \u043A\u043D\u043E\u043F\u043A\u0443
      \xAB\u0412\u0441\u0435 \u043D\u0430 \u0434\u0435\u0440\u0435\u0432\u043E\xBB,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u0440\u0430\u0431\u043E\u0447\u0438\u0445 \u0434\u043E\u0431\u044B\u0432\u0430\u0442\u044C
      \u0434\u0435\u0440\u0435\u0432\u043E."
    _messageEn: Click the "All to Wood" button to send workers to chop wood.
    _allowManualNext: 0
    _requiredBuildingConfig: {fileID: 0}
    _minimumWood: 0
    _minimumGold: 0
    _minimumMeat: 0
  - _stepType: 0
    _message: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u0420\u0430\u0431\u043E\u0447\u0438\u0435
      \u0443\u0436\u0435 \u0440\u0443\u0431\u044F\u0442 \u043B\u0435\u0441. \u041F\u043E\u043A\u0430
      \u043E\u043D\u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0442 \u0440\u0435\u0441\u0443\u0440\u0441\u044B,
      \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u043C \u0430\u0440\u043C\u0438\u044E."
    _messageEn: Great! Workers are already chopping wood. While they gather resources,
      let's prepare an army.
    _allowManualNext: 1
    _requiredBuildingConfig: {fileID: 0}
    _minimumWood: 0
    _minimumGold: 0
    _minimumMeat: 0
  - _stepType: 3
    _message: "\u0412\u044B\u0431\u0435\u0440\u0438 \u043D\u0430 \u043A\u0430\u0440\u0442\u0435
      \u043F\u0443\u0441\u0442\u043E\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A
      \u0434\u043B\u044F \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430."
    _messageEn: Select an empty building slot on the map.
    _allowManualNext: 0
    _requiredBuildingConfig: {fileID: 11400000, guid: 64b304de36f2ede47b453e895a7266e3, type: 2}
    _minimumWood: 20
    _minimumGold: 20
    _minimumMeat: 0
  - _stepType: 8
    _message: "\u0412\u044B\u0431\u0435\u0440\u0438 \u043A\u0430\u0437\u0430\u0440\u043C\u0443
      \u0432 \u0441\u043F\u0438\u0441\u043A\u0435 \u0437\u0434\u0430\u043D\u0438\u0439
      \u0438 \u043D\u0430\u0436\u043C\u0438 \xAB\u041F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C\xBB."
    _messageEn: Select the Barracks from the building list and click "Build".
    _allowManualNext: 0
    _requiredBuildingConfig: {fileID: 11400000, guid: 64b304de36f2ede47b453e895a7266e3, type: 2}
    _minimumWood: 20
    _minimumGold: 20
    _minimumMeat: 0
  - _stepType: 9
    _message: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438, \u043F\u043E\u043A\u0430
      \u043A\u0430\u0437\u0430\u0440\u043C\u0430 \u0434\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F."
    _messageEn: Wait until the Barracks is finished building.
    _allowManualNext: 0
    _requiredBuildingConfig: {fileID: 11400000, guid: 64b304de36f2ede47b453e895a7266e3, type: 2}
    _minimumWood: 0
    _minimumGold: 0
    _minimumMeat: 0
  - _stepType: 10
    _message: "\u041D\u0430\u0436\u043C\u0438 \u043D\u0430 \u0433\u043E\u0442\u043E\u0432\u0443\u044E
      \u043A\u0430\u0437\u0430\u0440\u043C\u0443."
    _messageEn: Click on the completed Barracks.
    _allowManualNext: 0
    _requiredBuildingConfig: {fileID: 11400000, guid: 64b304de36f2ede47b453e895a7266e3, type: 2}
    _minimumWood: 0
    _minimumGold: 0
    _minimumMeat: 0
  - _stepType: 4
    _message: "\u041D\u0430\u0439\u043C\u0438 \u043F\u0435\u0440\u0432\u043E\u0433\u043E
      \u0432\u043E\u0438\u043D\u0430 \u2014 \u043D\u0430\u0436\u043C\u0438 \xAB\u041D\u0430\u043D\u044F\u0442\u044C\xBB."
    _messageEn: "Hire your first warrior \u2014 click \"Hire\"."
    _allowManualNext: 0
    _requiredBuildingConfig: {fileID: 0}
    _minimumWood: 10
    _minimumGold: 0
    _minimumMeat: 10
  - _stepType: 11
    _message: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438, \u043F\u043E\u043A\u0430
      \u0432\u043E\u0438\u043D \u0432\u044B\u0439\u0434\u0435\u0442 \u0438\u0437
      \u043A\u0430\u0437\u0430\u0440\u043C\u044B."
    _messageEn: Wait until the warrior exits the Barracks.
    _allowManualNext: 0
    _requiredBuildingConfig: {fileID: 0}
    _minimumWood: 0
    _minimumGold: 0
    _minimumMeat: 0
  - _stepType: 5
    _message: "\u0412\u044B\u0431\u0435\u0440\u0438 \u0441\u0432\u043E\u0435\u0433\u043E
      \u0431\u043E\u0435\u0432\u043E\u0433\u043E \u044E\u043D\u0438\u0442\u0430."
    _messageEn: Select your combat unit.
    _allowManualNext: 0
    _requiredBuildingConfig: {fileID: 0}
    _minimumWood: 0
    _minimumGold: 0
    _minimumMeat: 0
  - _stepType: 6
    _message: "\u0412\u043E\u0442 \u0432\u0440\u0430\u0433! \u041D\u0430\u0436\u043C\u0438
      \u043F\u043E \u043D\u0435\u043C\u0443, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u0434\u0430\u0442\u044C
      \u0430\u0440\u043C\u0438\u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u0443 \u0430\u0442\u0430\u043A\u0438."
    _messageEn: There's the enemy! Click on them to order your army to attack.
    _allowManualNext: 0
    _requiredBuildingConfig: {fileID: 0}
    _minimumWood: 0
    _minimumGold: 0
    _minimumMeat: 0
  - _stepType: 13
    _message: "\u0414\u043E\u0436\u0434\u0438\u0441\u044C, \u043F\u043E\u043A\u0430
      \u0442\u0432\u043E\u0439 \u0432\u043E\u0438\u043D \u0434\u043E\u0439\u0434\u0451\u0442
      \u0434\u043E \u0431\u043E\u044F."
    _messageEn: Wait until your warrior reaches the battle.
    _allowManualNext: 0
    _requiredBuildingConfig: {fileID: 0}
    _minimumWood: 0
    _minimumGold: 0
    _minimumMeat: 0
  - _stepType: 14
    _message: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u0422\u0435\u043F\u0435\u0440\u044C
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u044C \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0439
      \u0437\u0430\u043C\u043E\u043A, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C
      \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435. \u041D\u0430\u043D\u0438\u043C\u0430\u0439
      \u0440\u0430\u0431\u043E\u0447\u0438\u0445, \u0441\u0442\u0440\u043E\u0439
      \u043D\u043E\u0432\u044B\u0435 \u0437\u0434\u0430\u043D\u0438\u044F \u0438
      \u0441\u043E\u0431\u0438\u0440\u0430\u0439 \u0430\u0440\u043C\u0438\u044E \u2014
      \u043F\u043E\u0431\u0435\u0434\u0430 \u0431\u0443\u0434\u0435\u0442 \u0437\u0430
      \u0442\u043E\u0431\u043E\u0439!"
    _messageEn: "Great! Now destroy the enemy castle to complete the tutorial. Hire
      workers, build new structures, and gather your army \u2014 victory will be
      yours!"
    _allowManualNext: 1
    _requiredBuildingConfig: {fileID: 0}
    _minimumWood: 0
    _minimumGold: 0
    _minimumMeat: 0
